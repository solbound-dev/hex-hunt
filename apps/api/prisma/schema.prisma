generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wallet {
  id          String       @id
  loginNonce  String?
  gameId      String?      @db.Uuid
  gamePlayers GamePlayer[]
  game        Game?        @relation(fields: [gameId], references: [id])
}

model Game {
  id          String       @id @default(uuid()) @db.Uuid
  createdAt   DateTime     @default(now())
  gamePlayers GamePlayer[]
  turns       Turn[]
  players     Wallet[]
}

model GamePlayer {
  id              Int              @id @default(autoincrement())
  playerType      PlayerType
  initialQ        Int
  initialR        Int
  playerId        String
  gameId          String           @db.Uuid
  game            Game             @relation(fields: [gameId], references: [id])
  player          Wallet           @relation(fields: [playerId], references: [id])
  gamePlayerTurns GamePlayerTurn[]

  @@unique([gameId, playerId])
}

model Turn {
  id              Int              @id @default(autoincrement())
  turnNumber      Int
  cardPosQ        Int
  cardPosR        Int
  gameId          String           @db.Uuid
  gamePlayerTurns GamePlayerTurn[]
  game            Game             @relation(fields: [gameId], references: [id])
}

model GamePlayerTurn {
  id           Int        @id @default(autoincrement())
  pendingQ     Int?
  pendingR     Int?
  isShooting   Boolean?   @default(false)
  gamePlayerId Int
  turnId       Int
  gamePlayer   GamePlayer @relation(fields: [gamePlayerId], references: [id])
  turn         Turn       @relation(fields: [turnId], references: [id])

  @@unique([gamePlayerId, turnId])
}

enum PlayerType {
  Astronaut
  Alien
  Robot
  Wizard
}
