// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wallet {
  id         String  @id
  loginNonce String?

  gamePlayers GamePlayer[]
  game        Game?        @relation(fields: [gameId], references: [id])
  gameId      Int?
}

model Game {
  id       Int    @id @default(autoincrement())
  gameCode String

  players     Wallet[]
  gamePlayers GamePlayer[]
  turns       Turn[]
}

model GamePlayer {
  id Int @id @default(autoincrement())

  playerType PlayerType
  initialQ   Int
  initialR   Int

  game            Game             @relation(fields: [gameId], references: [id])
  gameId          Int
  player          Wallet           @relation(fields: [playerId], references: [id])
  playerId        String
  gamePlayerTurns GamePlayerTurn[]
}

model Turn {
  id Int @id @default(autoincrement())

  turnNumber Int
  cardPosQ   Int
  cardPosR   Int

  gamePlayerTurns GamePlayerTurn[]
  game            Game             @relation(fields: [gameId], references: [id])
  gameId          Int
}

model GamePlayerTurn {
  id Int @id @default(autoincrement())

  pendingQ   Int
  pendingR   Int
  isShooting Boolean @default(false)

  gamePlayer   GamePlayer @relation(fields: [gamePlayerId], references: [id])
  gamePlayerId Int
  turn         Turn       @relation(fields: [turnId], references: [id])
  turnId       Int
}

enum PlayerType {
  Astronaut
  Alien
  Robot
  Wizard
}
