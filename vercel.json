{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/((?!assets/|\\.well-known/|android-chrome-192x192\\.png|android-chrome-512x512\\.png|apple-touch-icon\\.png|favicon-16x16\\.png|favicon-32x32\\.png|favicon\\.ico|manifest\\.json|service-worker\\.js|.*\\.[^/]+$).*)",
      "dest": "/index.html"
    }
  ]
}
