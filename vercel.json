{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "apps/web/assets/$1" },
    { "src": "/\\.well-known/(.*)", "dest": "apps/web/.well-known/$1" },
    {
      "src": "/android-chrome-192x192\\.png",
      "dest": "apps/web/android-chrome-192x192.png"
    },
    {
      "src": "/android-chrome-512x512\\.png",
      "dest": "apps/web/android-chrome-512x512.png"
    },
    {
      "src": "/apple-touch-icon\\.png",
      "dest": "apps/web/apple-touch-icon.png"
    },
    {
      "src": "/favicon-16x16\\.png",
      "dest": "apps/web/favicon-16x16.png"
    },
    {
      "src": "/favicon-32x32\\.png",
      "dest": "apps/web/favicon-32x32.png"
    },
    { "src": "/favicon\\.ico", "dest": "apps/web/favicon.ico" },
    { "src": "/manifest\\.json", "dest": "apps/web/manifest.json" },
    {
      "src": "/service-worker\\.js",
      "dest": "apps/web/service-worker.js"
    },

    { "src": "/(.*)", "dest": "apps/web/index.html" }
  ]
}
